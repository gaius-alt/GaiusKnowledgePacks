{
  "skyrimnet_knowledge_pack": {
    "author": "_gaius",
    "description": "Quests in the Pale — Dawnstar's nightmares, the Pale Lady, Mehrunes' Razor, and Skald's thaneship. Replaces the older Dawnstar Quests pack. Public events stay hold-wide; private contracts are tightened.",
    "entry_count": 5,
    "exported_at": "2026-05-18T04:54:36Z",
    "format_version": 2,
    "name": "_VKP - Pale Quests",
    "npc_groups": [],
    "version": "1.0.0",
    "entries": [
      {
        "always_inject": false,
        "condition_expr": "is_in_faction(actorUUID, \"CrimeFactionPale\") or is_in_faction(actorUUID, \"TownDawnstarFaction\")",
        "content": "{% if get_quest_stage(\"DA16\", false) < 25 %}The people of Dawnstar can't sleep. A waking nightmare grips the town — Erandur, a priest of Mara, has come to investigate Nightcaller Temple beneath the Tower of Dawn.{% elif get_quest_stage(\"DA16\", false) < 50 %}{{ playerName }} is helping Erandur reach Nightcaller Temple, the source of Dawnstar's nightmares.{% elif get_quest_stage(\"DA16\", false) < 200 %}{{ playerName }} stands before the Skull of Corruption inside Nightcaller Temple. Erandur — once a Vaermina cultist — wants it destroyed. Vaermina herself disagrees.{% else %}Dawnstar can sleep again. {{ playerName }} let Erandur destroy the Skull of Corruption, or killed him for it and took the Skull. Either way the nightmares are done.{% endif %}",
        "display_name": "Waking Nightmare",
        "emotion": "",
        "importance": 0.9,
        "knowledge_key": "quest.pale.waking_nightmare",
        "location": "",
        "tags": [
          "pale",
          "investigation",
          "daedric",
          "dreams",
          "Erandur",
          "Vaermina"
        ],
        "type": "KNOWLEDGE"
      },
      {
        "always_inject": false,
        "condition_expr": "is_in_faction(actorUUID, \"CrimeFactionPale\") or is_in_faction(actorUUID, \"TownDawnstarFaction\")",
        "content": "{% if get_quest_stage(\"dunFrostmereCryptQST\", false) == 0 %}The Pale Lady cannot be put down while her blade is out of its pedestal. The spirit follows whoever carries The Pale Blade out of Frostmere Crypt, and the only way to be rid of her is to put it back where it came from.{% elif get_quest_stage(\"dunFrostmereCryptQST\", false) < 100 %}{{ playerName }} is investigating the haunting at Frostmere Crypt and the cursed sword The Pale Blade.{% else %}{{ playerName }} banished the Pale Lady from Frostmere Crypt and recovered the cursed blade.{% endif %}",
        "display_name": "The Pale Lady",
        "emotion": "",
        "importance": 0.75,
        "knowledge_key": "quest.pale.pale_lady",
        "location": "",
        "tags": [
          "pale",
          "fetch",
          "undead",
          "cursed",
          "favor"
        ],
        "type": "KNOWLEDGE"
      },
      {
        "always_inject": false,
        "condition_expr": "actorName == \"Captain Wayfinder\"",
        "content": "{% if get_quest_stage(\"FreeformShipsDawnstar\", false) < 20 %}Captain Wayfinder at the Dawnstar docks is looking for someone to recover his lost book — 'Night Falls on Sentinel' — that he claims has sentimental value.{% else %}{{ playerName }} brought Captain Wayfinder his book back. The docks are quieter for it.{% endif %}",
        "display_name": "Salty Sea-Dogs",
        "emotion": "",
        "importance": 0.65,
        "knowledge_key": "quest.pale.salty_sea_dogs",
        "location": "",
        "tags": [
          "pale",
          "fetch",
          "maritime",
          "favor",
          "misc_quest"
        ],
        "type": "KNOWLEDGE"
      },
      {
        "always_inject": false,
        "condition_expr": "actorName == \"Silus Vesuius\" or is_in_faction(actorUUID, \"CrimeFactionPale\") or is_in_faction(actorUUID, \"TownDawnstarFaction\")",
        "content": "{% if get_quest_stage(\"DA07\", false) < 13 %}Silus Vesuius is offering good coin to anyone willing to go and fetch the last pieces of Mehrunes' Razor for him. Dawnstar is not enthusiastic — putting a Daedric Prince's dagger back together strikes most of the town as a poor idea.{% elif get_quest_stage(\"DA07\", false) < 50 %}{{ playerName }} is gathering the scattered pieces of Mehrunes' Razor from across Skyrim for Silus Vesuius.{% elif get_quest_stage(\"DA07\", false) < 100 %}{{ playerName }} brought the pieces to Silus, and the two are heading for Mehrunes Dagon's shrine to reforge the dagger.{% else %}Mehrunes' Razor is reforged. The Daedric Prince left it with {{ playerName }} after demanding the life of Silus — paid or refused.{% endif %}",
        "display_name": "Pieces of the Past",
        "emotion": "",
        "importance": 0.85,
        "knowledge_key": "quest.pale.pieces_of_the_past",
        "location": "",
        "tags": [
          "pale",
          "fetch",
          "daedric",
          "collecting",
          "mythic_dawn",
          "Mehrunes Dagon"
        ],
        "type": "KNOWLEDGE"
      },
      {
        "always_inject": false,
        "condition_expr": "is_in_faction(actorUUID, \"CrimeFactionPale\") or is_in_faction(actorUUID, \"TownDawnstarFaction\")",
        "content": "{% if get_quest_stage(\"Favor256\", false) == 0 %}Jarl Skald the Elder of Dawnstar may grant the title of Thane to those who serve the people of the Pale.{% elif get_quest_stage(\"Favor256\", false) < 200 %}The Jarl asked {{ playerName }} to do more for the Pale before any thaneship could be granted.{% else %}{{ playerName }} has been named Thane of the Pale by Jarl Skald the Elder.{% endif %}",
        "display_name": "Thane of the Pale",
        "emotion": "",
        "importance": 0.85,
        "knowledge_key": "quest.pale.thane_of_the_pale",
        "location": "",
        "tags": [
          "pale",
          "thane",
          "jarl_court",
          "favor",
          "misc_quest"
        ],
        "type": "KNOWLEDGE"
      }
    ]
  }
}